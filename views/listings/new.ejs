<% layout("/layouts/boilerplate") %>
<div class="row">
    <div class="col-8 offset-2">
    <h3> Create the New Listings!</h3>
    <br>
    <form method="POST" action="/listings"  class="needs-validation" novalidate enctype="multipart/form-data" >
        <div class="mb-3">
            <label for="title" class="form-label">Title</label>
            <input 
            class="form-control" 
            name="listing[title]" 
            placeholder="Title"
            type="text"
            required>
            <div class="valid-feedback">title looks good!</div>
        </div>
        <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea 
            name="listing[description]"
            placeholder="enter description"
            class="form-control" 
            required
            ></textarea>
        </div>
        
        <div class="mb-3">
            <label for="image" class="form-label"> Upload Listing Image</label>
            <input class="form-control" 
            name="listing[image][url]"
            type="file">
        </div>
        <div class="row">
            <div class="mb-3 col-md-4">
                <label for="price" class="form-label ">Price</label>
                <input name="listing[price]" 
                placeholder="1200" 
                class="form-control"
                required
                type="number">
                <div class="invalid-feedback">Please enter the valid price</div>
            </div>

            <div class="mb-3 col-md-8">
                <label for="country" class="form-label">Country</label>
                <input 
                name="listing[country]" 
                placeholder="India"
                class="form-control"
                required
                type="text">
                <div class="invalid-feedback">Please enter the country name</div>
            </div>
        </div>
        <div class="mb-3">
            <label for="location" class="form-label">Location</label>
            <input
            name="listing[location]" 
            placeholder="Hyderabad,Telangana" 
            class="form-control"
            required
            type="text">
            <div class="invalid-feedback">Please enter the country name</div>
        </div>
        <br>
        <br>
        <button class="btn btn-dark add-btn">Add</button>
    </form>
    </div>
</div>
